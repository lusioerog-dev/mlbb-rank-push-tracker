{
  "name": "mlbb-rank-push-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "inspect": "tsx collector/src/cli.ts",
    "test": "tsx --test collector/tests/*.test.ts packages/tracker/*.test.ts apps/api/*.test.ts",
    "api:dev": "wrangler dev",
    "api:deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/vite": "4.3.3",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.2"
  }
}
